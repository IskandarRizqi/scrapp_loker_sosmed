# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JINA_READER_BASE_URL: Base URL of the public reader proxy used by the auto-scan
# bot to fetch live public Instagram/Facebook pages (renders JS into markdown).
# Free tier is rate-limited (~20 RPM/IP). Optional.
JINA_READER_BASE_URL="https://r.jina.ai"

# SCAN_SOURCES_FILE: Path (relative to project root) to the JSON file listing the
# Instagram/Facebook accounts & hashtags the auto-scan bot will crawl.
# You can edit this file anytime without changing code.
SCAN_SOURCES_FILE="loker-sources.json"

# DISCOVERY_QUERY_LIMIT: Max search queries used per auto-scan run to discover
# Instagram posts. Higher = wider pool but more requests (free tier ~20 RPM/IP).
DISCOVERY_QUERY_LIMIT=30

# DISCOVERY_DELAY_MS: Delay between discovery requests to stay under jina rate limits.
# ~1500ms keeps ~40 requests/min; raise (e.g. 2000-2500) if you see HTTP 403 from r.jina.ai.
DISCOVERY_DELAY_MS=1500

# DISCOVERY_CONCURRENCY: How many search queries are processed in parallel during discovery.
DISCOVERY_CONCURRENCY=3

# DISCOVERY_MAX_PAGES: Max result pages fetched per query on DuckDuckGo (until empty).
DISCOVERY_MAX_PAGES=2

# DISCOVERY_MAX_JINA_REQUESTS: Hard cap on r.jina.ai requests per run (discovery + Bing
# fallback + caption/slide fallbacks). Discovery stops cleanly once the cap is reached.
DISCOVERY_MAX_JINA_REQUESTS=60

# ANALYZE_CONCURRENCY: How many posts are analyzed by Gemini in parallel.
ANALYZE_CONCURRENCY=8

# THREADS_SCAN_BUDGET_MS: Max time (ms) the Threads auto-scan scrolls a single profile.
THREADS_SCAN_BUDGET_MS=240000

# THREADS_SCROLL_STALL_LIMIT: Consecutive scrolls without new posts before the profile is considered done.
THREADS_SCROLL_STALL_LIMIT=4

# SCRAPER_API_URL: Base URL endpoint Scraper Ingestion API (menerima hasil scraping lowongan
# ke draft database). Format POST /api/v1/scraper/loker-draft.
SCRAPER_API_URL="https://bankiracademy.co.id/api/v1/scraper/loker-draft"

# SCRAPER_API_KEY: Kunci rahasia (header X-Scraper-Api-Key) untuk otentikasi bot/scraper.
# Jika kosong, pengiriman ke API otomatis dilewati (log warning) tanpa mengganggu alur batch/Excel.
SCRAPER_API_KEY=""

# ---- WhatsApp Notification (kirim jumlah loker hasil run ke WhatsApp) ----
# WA_API_URL: Base URL Merchant API WA Gateway. Endpoint yang dipanggil: POST /api/v1/messages.
WA_API_URL="https://<host-merchant>"

# WA_API_KEY: API Key Merchant (header Authorization: Bearer wapi_live_<API_KEY>).
# Jangan expose di frontend/repository. Jika kosong, notifikasi WA dilewati (log warning).
WA_API_KEY=""

# WA_TO_NUMBER: Nomor WhatsApp tujuan dengan format internasional (contoh: 628xxxxxxxxxx).
WA_TO_NUMBER=""
